     return f"{base}/.well-known/oauth-protected-resource/servers/{server_id}/mcp"
 
 
+def _build_oauth_challenge(scope: Scope, server_id: str, scopes: Optional[list[str]] = None) -> str:
+    """Build an OAuth challenge with configured scope guidance.
+
+    Args:
+        scope: ASGI connection scope.
+        server_id: Virtual-server identifier.
+        scopes: Minimal scopes configured for the resource.
+
+    Returns:
+        Bearer challenge with resource metadata and valid RFC 6749 scope tokens.
+    """
+    resource_metadata = _build_resource_metadata_url(scope, server_id)
+    challenge = f'Bearer resource_metadata="{resource_metadata}"' if resource_metadata else "Bearer"
+    if not isinstance(scopes, list) or not scopes:
+        return challenge
+    # RFC 6749 scope tokens exclude whitespace, quotes, backslashes, and non-ASCII characters.
+    if any(not isinstance(value, str) or not re.fullmatch(r"[\x21\x23-\x5b\x5d-\x7e]+", value) for value in scopes):
+        logger.warning("Invalid OAuth challenge scopes configured for server %s", sanitize_for_log(server_id))
+        return challenge
+    required = list(dict.fromkeys(value for value in scopes if value != "offline_access"))
+    if required:
+        challenge += f', scope="{" ".join(required)}"'
+    return challenge
+
